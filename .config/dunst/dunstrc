[global]
    font = JetBrainsMono Nerd Font 10
    corner_radius = 8
    frame_width = 1
    gap_size = 8
    offset = (10, 10)

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"

[urgency_low]
    background = "#1a1b26"
    foreground = "#a9b1d6"
    frame_color = "#414868"

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
