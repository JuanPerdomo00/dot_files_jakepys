{
    "position": "top",
    "height": 24,
    "start": [
        {
            "type": "workspaces",
            "name_map": {
                "1": " ",
                "2": "Δ",
                "3": "λ",
                "4": "Γ",
                "5": "τ",
                "6": "Σ",
                "7": "Π",
                "8": "β",
                "9": "ε",
                "10": "∀"
            },
            "favorites": [
                "1",
                "2",
                "3"
            ],
            "all_monitors": true
        },
        {
            "type": "label",
            "label": "|",
            "class": "sep"
        },
        {
            "type": "script",
            "cmd": "~/.config/ironbar/scripts/check_updates.sh",
            "mode": "poll",
            "interval": 600000,
            "on_click_left": "~/.config/ironbar/scripts/update_system.sh"
        },
        {
            "type": "label",
            "label": "|",
            "class": "sep"
        },
        {
            "type": "script",
            "cmd": "~/.config/ironbar/scripts/cava.sh",
            "mode": "watch"
        }
    ],
    "center": [
        {
            "type": "focused",
            "icon_size": 25,
            "truncate": {
                "length": 15,
                "max_length": 20,
                "mode": "middle"
            },
            "show_title": true
        }
    ],
    "end": [
        {
            "type": "label",
            "label": "|",
            "class": "sep"
        },
        {
            "type": "sys_info",
            "format": [
                " {cpu_percent}%"
            ],
            "interval": {
                "cpu": 1,
                "temps": 5
            },
            "tooltip": "{{2000:python3 /home/jakepys/.config/ironbar/scripts/procncpu.py}}"
        },
        {
            "format": [
                " {memory_used} / {memory_total} GB",
                "󰋊 {disk_total#T@/:.1} TB ({disk_percent@/}%)"
            ],
            "interval": {
                "disks": 300,
                "memory": 30,
                "temps": 5
            },
            "type": "sys_info"
        },
        {
            "type": "label",
            "label": "|",
            "class": "sep"
        },
        {
            "type": "volume",
            "format": "{icon} {percentage}%",
            "sink_slider_orientation": "vertical",
            "max_volume": 100,
            "truncate": "end",
            "truncate_popup": "middle",
            "icons": {
                "volume": "󰕾",
                "muted": "󰝟"
            },
            "profiles": {
                "medium": {
                    "when": 66.66,
                    "icons": {
                        "volume": "󰖀"
                    }
                },
                "low": {
                    "when": 33.33,
                    "icons": {
                        "volume": "󰕿"
                    }
                }
            }
        },
        {
            "type": "label",
            "label": "|",
            "class": "sep"
        },
        {
            "type": "network_manager",
            "icon_size": 24,
            "signal_strength": "wifi",
            "interface_blacklist": [
                "lo",
                "virbr0"
            ],
            "on_click_left": "kitty --class impala -e sudo impala",
            "profiles": {
                "wifi_disconnected": {
                    "when": {
                        "type": "wifi",
                        "state": "disconnected"
                    },
                    "icon": "icon:network-wireless-offline-symbolic"
                },
                "vpn_connected": {
                    "when": {
                        "type": "vpn",
                        "state": "connected"
                    },
                    "icon": "icon:network-vpn-symbolic"
                },
                "vpn_disconnected": {
                    "when": {
                        "type": "vpn",
                        "state": "disconnected"
                    },
                    "icon": "icon:network-vpn-disconnected-symbolic"
                }
            }
        },
        {
            "type": "label",
            "label": "|",
            "class": "sep"
        },
        {
            "type": "tray"
        },
        {
            "type": "label",
            "label": "|",
            "class": "sep"
        },
        {
            "type": "clock",
            "format": "%d/%m/%Y %I:%M %p"
        },
        {
            "type": "label",
            "label": "|",
            "class": "sep"
        },
        {
            "type": "battery",
            "show_if": "ls /sys/class/power_supply/ | grep --quiet '^BAT'",
            "thresholds": {
                "warning": 20,
                "critical": 5
            }
        }
    ]
}
