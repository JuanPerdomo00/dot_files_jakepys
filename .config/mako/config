font=Iosevka Nerd Font 10
background-color=#120a24ee
text-color=#e8d8ff
width=350
height=120
margin=15
padding=15
border-size=3
border-radius=12

anchor=top-right

sort=-time
layer=overlay
default-timeout=6000
ignore-timeout=0
max-visible=3
icons=1
max-icon-size=48
markup=1
actions=1

on-button-left=dismiss
on-button-right=dismiss-all

[urgency=low]
border-color=#4a2c82
background-color=#120a2499
default-timeout=3000

[urgency=normal]
border-color=#c04df0

[urgency=high]
border-color=#ff5c7a
background-color=#120a24ff
default-timeout=0
