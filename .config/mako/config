font=Iosevka Nerd Font 10
background-color=#1c1b19ee
text-color=#e6dac4
width=350
height=120
margin=15
padding=15
border-size=3
border-radius=12

anchor=top-right

sort=-time
layer=overlay
default-timeout=6000
ignore-timeout=0
max-visible=3
icons=1
max-icon-size=48
markup=1
actions=1

on-button-left=dismiss
on-button-right=dismiss-all

[urgency=low]
border-color=#3a3834
background-color=#1c1b1999
default-timeout=3000

[urgency=normal]
border-color=#e08060

[urgency=high]
border-color=#b07878
background-color=#1c1b19ff
default-timeout=0
