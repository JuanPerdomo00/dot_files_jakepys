{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "none",
    "color": {
      "1": "38;2;122;162;247",
      "2": "38;2;157;124;216"
    },
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys":   "38;2;122;162;247",
      "title":  "38;2;192;202;245",
      "output": "38;2;169;177;214"
    }
  },
  "modules": [
    {
      "key": "╭──────────── SYSTEM",
      "type": "custom"
    },
    {
      "key": "├─  OS",
      "type": "os"
    },
    {
      "key": "├─ 󰍹  Display",
      "type": "display"
    },
    {
      "key": "├─ 󰒋  Host",
      "type": "title",
      "format": "{host-name}"
    },
    {
      "key": "├─ 󰍛  CPU",
      "type": "cpu",
      "showPeCoreCount": true
    },
    {
      "key": "├─ 󰘚  GPU",
      "type": "gpu"
    },
    {
      "key": "├─ 󱡨  Kernel",
      "type": "kernel"
    },
    {
      "key": "╰─ 󰍜  RAM",
      "type": "memory"
    },
    {
      "key": "╭──────────── USER",
      "type": "custom"
    },
    {
      "key": "├─ 󰀄  User",
      "type": "title",
      "format": "{user-name}"
    },
    {
      "key": "├─ 󱂬  WM",
      "type": "wm"
    },
    {
      "key": "├─   Terminal",
      "type": "terminal"
    },
    {
      "key": "├─   Shell",
      "type": "shell"
    },
    {
      "key": "╰─ 󰅐  Uptime",
      "type": "uptime"
    }
  ]
}
