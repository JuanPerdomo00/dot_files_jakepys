{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"source": "arch_small",
		"padding": {
			"top": 2
		}
	},
	"display": {
		"separator": " "
	},
	"modules": [
		{
			"key": "╭──────────── SYSTEM",
			"type": "custom"
		},
		{
			"key": "├─ 󰌽 OS -> {#keys}",
			"type": "os"
		},
		{
			"key": "├─  DISPLAY -> {#keys}",
			"type": "display"
		},
		{
			"key": "├─ 󰇅 Host -> {#keys}",
			"type": "title",
			"format": "{host-name}"
		},
		{
			"key": "├─ 󰍛 CPU -> {#keys}",
			"type": "cpu",
			"showPeCoreCount": true
		},
		{
			"key": "╰─  RAM -> {#keys}",
			"type": "memory"
		},
		{
			"key": "╭──────────── USER",
			"type": "custom"
		},
		{
			"key": "├─  User -> {#keys}",
			"type": "title",
			"format": "{user-name}"
		},
		{
			"key": "├─  Window Manager -> {#keys}",
			"type": "wm"
		},
		{
			"key": "├─  Terminal -> {#keys}",
			"type": "terminal"
		},
		{
			"key": "╰─  Shell -> {#keys}",
			"type": "shell"
		}
	]
}
