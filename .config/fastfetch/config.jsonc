{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "none"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys":   "38;2;180;160;210",
      "output": "38;2;200;185;220"
    }
  },
  "modules": [
    {
      "key": " os",
      "type": "os"
    },
    {
      "key": " host",
      "type": "title",
      "format": "{host-name}"
    },
    {
      "key": " kernel",
      "type": "kernel"
    },
    {
      "key": " cpu",
      "type": "cpu",
      "showPeCoreCount": false
    },
    {
      "key": " gpu",
      "type": "gpu"
    },
    {
      "key": " ram",
      "type": "memory"
    },
    {
      "key": " wm",
      "type": "wm"
    },
    {
      "key": " shell",
      "type": "shell"
    },
    {
      "key": " uptime",
      "type": "uptime"
    }
  ]
}
