	email = perdomojuan187@gmail.com
[core]
	editor = nvim
	autocrlf = input
	compression = 9
    preloadindex = true
    pager = delta
[init]
	defaultBranch = dev

[status]
	branch = true 
	showStash = true
	showUntrackedFiles = all

[diff]
	context = 3
	renames = copies
	interHunkContext = 10


[commit]
	template = ~/.config/git/template
	verbose = true
	gpgsign = false

[alias]
	lg = log --graph --oneline --pretty=format:'%h <%an> %s %Cgreen%d'
	cmm = commit
	s = status --short -b
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
    required = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    syntax-theme = vaporwave

    plus-style = syntax "#1e3a2f"
    plus-emph-style = syntax "#2f6b4a"
    minus-style = syntax "#3d1530"
    minus-emph-style = syntax "#7a1f45"
    zero-style = syntax

    file-style = bold "#ff6ec7"
    file-decoration-style = "#4a2c82" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#4a2c82" box
    hunk-header-file-style = "#c04df0"
    hunk-header-line-number-style = "#ffc857"

    line-numbers-left-style = "#4a2c82"
    line-numbers-right-style = "#4a2c82"
    line-numbers-minus-style = "#e5384f"
    line-numbers-plus-style = "#a8f0a0"
    line-numbers-zero-style = "#6e5aa8"
